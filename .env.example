# Your LeetCode username (public profile)
LEETCODE_USERNAME=your_username

# The ID of the Google Sheet to write to (the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_sheet_id

# Path to the Google service-account JSON key file
GOOGLE_CREDENTIALS_FILE=credentials.json

# Optional: your LeetCode session cookie, used ONLY by `backfill` to import your
# full solved history. Copy it from your browser (DevTools -> Application ->
# Cookies -> LEETCODE_SESSION). It is a secret and expires periodically — keep
# it private and never commit it. Leave unset if you backfill with --file.
# LEETCODE_SESSION=your_leetcode_session_cookie
